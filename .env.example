# Vorlage. Kopieren nach .env.local (gitignored) und ausfüllen.
# Nur EXPO_PUBLIC_*-Variablen landen im App-Bundle — also ausschließlich
# öffentliche Werte. Der Anthropic-API-Key kommt NIEMALS hierher, der lebt
# als Secret in der Supabase Edge Function (PLAN.md Abschnitt 4).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
